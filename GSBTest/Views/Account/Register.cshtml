    <link rel="stylesheet" href="../assets/vendor/fonts/boxicons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="../assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="../assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="../assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="../assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <!-- Page CSS -->
    <!-- Page -->
    <link rel="stylesheet" href="../assets/vendor/css/pages/page-auth.css" />
    <!-- Helpers -->
    <script src="../assets/vendor/js/helpers.js"></script>

    <!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js in the <head> section -->
    <!--? Config:  Mandatory theme config file contain global vars & default theme options, Set your preferred theme option in this file.  -->
    <script src="../assets/js/config.js"></script>
</head>

<body>
    <!-- Content -->
    <div class="container-xxl">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <!-- Register Card -->
                <div class="card">
                    <div class="card-body">
                        <span>
                            <img src="~/assets/img/logo/gsb_logo.svg" alt="Gençlik ve Spor Bakanlığı" />
                        </span>
                        <p></p>
                        <h2 class="mb-2">HOŞGELDİNİZ </h2>
                        <p class="mb-4">
                            Hesap oluşturunuz
                        </p>

                        <form id="formAuthentication" class="mb-3" method="POST">
                            <div class="mb-3">
                                <label for="KullaniciAdi" class="form-label">Kullanıcı Adı</label>
                                <input type="text" class="form-control" id="KullaniciAdi" name="KullaniciAdi"
                                       placeholder="Kullanıcı adınızı giriniz" autofocus />
                                <div id="kullaniciAdiError" class="text-danger" style="display: none;">Kullanıcı adı boş bırakılamaz.</div>
                            </div>
                            <div class="mb-3">
                                <label for="KullaniciEmail" class="form-label">Email Adresi</label>
                                <input type="text" class="form-control" id="KullaniciEmail" name="KullaniciEmail"
                                       placeholder="Email adresinizi giriniz" />
                                <div id="emailError" class="text-danger" style="display: none;">Email adresi boş bırakılamaz.</div>
                            </div>
                            <div class="mb-3 form-password-toggle">
                                <label class="form-label" for="KullaniciSifre">Şifre</label>
                                <div class="input-group input-group-merge">
                                    <input type="password" id="KullaniciSifre" class="form-control" name="KullaniciSifre"
                                           placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                           aria-describedby="KullaniciSifre" />
                                    <span class="input-group-text cursor-pointer"><i class="bx bx-hide"></i></span>
                                </div>
                                <div id="sifreError" class="text-danger" style="display: none;">Şifre boş bırakılamaz.</div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="terms-conditions" name="terms" />
                                    <label class="form-check-label" for="terms-conditions">
                                        <a href="javascript:void(0);">Gizlilik politikasını ve şartlarını</a> kabul ediyorum
                                    </label>
                                </div>
                                <div id="termsError" class="text-danger" style="display: none;">Şartlar ve koşullar kabul edilmelidir.</div>
                            </div>
                            <button type="button" class="btn btn-primary d-grid w-100" onclick="ekle()">Kayıt ol</button>
                        </form>

                        <p class="text-center">
                            <span>Zaten bir hesabın var mı</span>
                            @Html.ActionLink("Oturum açın", "Login", "Account", null, new { @class = "text-primary" })
                        </p>
                    </div>
                </div>
                <!-- Register Card -->
            </div>
        </div>
    </div>
    <!-- / Content -->

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script type="text/javascript">
        function ekle() {
            var isValid = true;

            // Kullanıcı Adı Kontrolü
            var kullaniciAdi = $('#KullaniciAdi').val();
            if (kullaniciAdi.trim() === '') {
                $('#kullaniciAdiError').show();
                isValid = false;
            } else {
                $('#kullaniciAdiError').hide();
            }

            // Email Kontrolü
            var email = $('#KullaniciEmail').val();
            if (email.trim() === '') {
                $('#emailError').show();
                isValid = false;
            } else {
                $('#emailError').hide();
            }

            // Şifre Kontrolü
            var sifre = $('#KullaniciSifre').val();
            if (sifre.trim() === '') {
                $('#sifreError').show();
                isValid = false;
            } else {
                $('#sifreError').hide();
            }

            // Şartlar ve Koşullar Kontrolü
            var termsChecked = $('#terms-conditions').is(':checked');
            if (!termsChecked) {
                $('#termsError').show();
                isValid = false;
            } else {
                $('#termsError').hide();
            }

            // Form Geçerliyse
            if (isValid) {
                var _data3 = new FormData($('#formAuthentication').get(0));

                $.ajax({
                    url: '@Url.Action("SaveUser", "Account")',
                    type: 'POST',
                    data: _data3,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.success) {
                            alert('Kayıt başarılı!');
                            window.location.href = '@Url.Action("Login", "Account")';
                        } else {
                            alert('Kayıt sırasında bir hata oluştu.');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log("Hata: " + xhr.responseText);
                        alert('İşleminiz sırasında bir hata oluştu.');
                    }
                });
            }
        }
    </script>

