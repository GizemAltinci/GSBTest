@model FilteredKullanici

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="card">
            <h5 class="card-header">Kullanıcı Filtrele</h5>
            <div class="table-responsive text-nowrap">
                @using (Html.BeginForm("KullaniciListele", "Home", FormMethod.Get))
                {
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="KullaniciAdi" class="form-label">KULLANICI ADI</label>
                            <input type="text" class="form-control" name="KullaniciAdi" id="KullaniciAdi" placeholder="---" value="@Model.KullaniciAdi" />
                        </div>

                        <div class="col-md-3">
                            <label for="KayitDurumu" class="form-label">KAYIT DURUMU</label>
                            <select class="form-select" name="KayitDurumu" id="KayitDurumu" aria-label="Default select example">
                                <option value="" disabled selected hidden>Seçiniz</option>
                                <option value="true">Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>

                        <div class="col-md-3 align-self-end">
                            <button type="submit" class="btn btn-primary">Filtrele</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Kullanıcı İşlemleri /</span> Kullanıcı Listele</h4>
                <form method="post" action="/Home/ExportToExcelKullanici" >
                    
                    <input type="hidden" name="KullaniciAdi" value="@Model.KullaniciAdi" />
                    <input type="hidden" name="KayitDurumu" value="@Model.KayitDurumu" />
                    <button type="submit" class="btn btn-success">Excel'e Aktar</button>
                </form>
            </div>
            <div class="table-responsive text-nowrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Kullanıcı Adı</th>
                            <th>Email</th>
                            <th>Şifre</th>
                            <th>Silinme Durumu</th>
                            <th>Kayıt Durumu</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var register in Model.UserData)
                        {
                            <tr>
                                <td>@(register.Id)</td>
                                <td>@(register.KullaniciAdi)</td>
                                <td>@(register.KullaniciEmail)</td>
                                <td>@(register.KullaniciSifre)</td>
                                <td class="text-center align-middle">
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="deleteReference(@register.Id)">
                                                <i class="bx bx-trash me-1"></i> Kayıdı sil
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center align-middle">
                                    @if (register.KayitDurumu)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        @if (register.KayitDurumu)
                                        {
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="FuncKayitDurumu(@register.Id, false)">
                                                <i class="bx bx-toggle-left me-1"></i> Pasifleştir
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="dropdown-item" href="javascript:void(0);" onclick="FuncKayitDurumu(@register.Id, true)">
                                                <i class="bx bx-toggle-right me-1"></i> Aktifleştir
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var selectedValue = '@Model.KayitDurumu';
        var selectElement = document.getElementById('KayitDurumu');
        if (selectedValue) {
            selectElement.value = selectedValue.toString();
        }
    });

    function deleteReference(id) {
        if (confirm('Are you sure you want to delete this reference?')) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteRegister", "Home")',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload(); // Reload the page to reflect changes
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("An error occurred. Please try again.");
                }
            });
        }
    }

    function FuncKayitDurumu(userId, newStatus) {
        $.ajax({
            url: '@Url.Action("FuncKayitDurumu", "Home")',
            type: 'POST',
            data: { id: userId, status: newStatus },
            success: function (response) {
                if (response.success) {
                    alert('Kullanıcı durumu güncellendi!');
                    location.reload(); // Sayfayı yenileyerek durumu güncelle
                } else {
                    alert('Güncelleme sırasında bir hata oluştu.');
                }
            },
            error: function (xhr, status, error) {
                console.log("Error: " + xhr.responseText);
                alert('İşlem sırasında bir hata oluştu.');
            }
        });
    }
</script>





