					</form>
					 <button type="button" class="btn btn-primary d-grid w-100" onclick="ekle()">Kayıt Ekle</button>

							
						
					</div>
				</div>
				<!-- /Form  -->
			
		</div>
	</div>
</div>



<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript">
    function ekle() {
        var isValid = true;

        // Kullanıcı Adı Kontrolü
        var kullaniciAdi = $('#KullaniciAdi').val();
        if (kullaniciAdi.trim() === '') {
            $('#kullaniciAdiError').show();
            isValid = false;
        } else {
            $('#kullaniciAdiError').hide();
        }

        // Email Kontrolü
        var email = $('#KullaniciEmail').val();
        if (email.trim() === '') {
            $('#emailError').show();
            isValid = false;
        } else {
            $('#emailError').hide();
        }

        // Şifre Kontrolü
        var sifre = $('#KullaniciSifre').val();
        if (sifre.trim() === '') {
            $('#sifreError').show();
            isValid = false;
        } else {
            $('#sifreError').hide();
        }

        // // Şartlar ve Koşullar Kontrolü
        // var termsChecked = $('#terms-conditions').is(':checked');
        // if (!termsChecked) {
        //     $('#termsError').show();
        //     isValid = false;
        // } else {
        //     $('#termsError').hide();
        // }

        // Form Geçerliyse
        if (isValid) {
            var _data3 = new FormData($('#KayitFormu').get(0));

            $.ajax({
                url: '@Url.Action("SaveUserIslem", "Home")',
                type: 'POST',
                data: _data3,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        alert('Kayıt başarılı!');  
                    } else {
                        alert('Kayıt sırasında bir hata oluştu.');
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Hata: " + xhr.responseText);
                    alert('İşleminiz sırasında bir hata oluştu.');
                }
            });
        }
    }
</script>

