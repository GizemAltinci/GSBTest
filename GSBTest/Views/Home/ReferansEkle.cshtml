
<div class="content-wrapper">
	<!-- Content -->

	<div class="container-xxl flex-grow-1 container-p-y">


		<div class="row">
			<!-- Form  -->
			
				<div class="card mb-4">
					@* <h5 class="card-header">Referans Ekle</h5> *@
					<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Referans İşlemleri /</span> Referans Ekle</h4>
					<div class="card-body">
							<form id="referansFormu" method="post">
								<div class="mb-3">
									<label for="Tip" class="form-label">Kategori Adı</label>
									<select class="form-select" name="Tip" id="Tip" aria-label="Default select example">
									
										 <option value="" disabled selected hidden>Seçiniz</option>
										@* @foreach (var kategori in kategoriler)
										{
											<option value="@kategori">@kategori</option>
										} *@


										<option value="Basvuran Birim">Basvuran Birim</option>
										<option value="Basvuru Yapilan Proje">Basvuru Yapilan Proje</option>
										<option value="Basvuru Yapilan Tur">Basvuru Yapilan Tur</option>
										<option value="Katilimci Turu">Katilimci Turu</option>
										<option value="Basvuru Donemi">Basvuru Donemi</option>
										<option value="Basvuru Durumu">Basvuru Durumu</option>
								
									</select>
								</div>
								<div class="mb-3">
									<label for="Alttip" class="form-label">Alttip Giriniz</label>
									<input type="text"
										  class="form-control"
										  name="Alttip"
										  id="Alttip"
										  placeholder="---" />
										    
								</div>
							</form>

							<button type="submit" class="btn btn-primary" onclick="ekle()">Yeni Kayıt Ekle</button>
							
						
					</div>
				</div>
				<!-- /Form  -->
			
		</div>
	</div>
</div>



<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript">


	function ekle() {
		debugger;
		var _data3 = new FormData($('#referansFormu').get(0));


		$.ajax({
			url: '@Url.Action("SaveRef", "Home")',
			type: 'POST',
			data: _data3,
			contentType: false,
			processData: false,
			success: function (response) {
				if (response.success) {
					alert('Ref saved successfully!');
				} else {
					alert('An error occurred while saving ref.');
				}
			},
			error: function (xhr, status, error) {
				console.log("Error: " + xhr.responseText);
				alert('There was an error processing your request.');
			}
		});
	}
</script>


